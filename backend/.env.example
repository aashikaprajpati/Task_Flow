PORT=4000
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRES_DAYS=7
DB_PATH=./db/taskflow.sqlite
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth (real sign-in). Get this from Google Cloud Console -> OAuth client ID.
# Leave blank if you don't have one configured yet - real Google sign-in will just be
# unavailable (it will NOT fall back to trusting unverified emails).
GOOGLE_CLIENT_ID=

# Set to "true" ONLY for local/offline evaluation without a Google Cloud project.
# Enables a fixed, hardcoded 3-account demo login (see DEMO_GOOGLE_EMAILS in auth.py).
# Never set this to true in a real deployment.
ALLOW_DEMO_GOOGLE_AUTH=true
